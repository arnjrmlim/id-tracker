APP_NAME="ID Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/id-tracker/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=id_tracker
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@id-tracker.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Network Image Path Mapping ────────────────────────────────────────────────
# When ID images are stored using a mapped Windows drive (e.g. Z:\),
# set the UNC root that the PHP/Apache process on the server can access.
#
# Example:
#   ID_TRACKER_NETWORK_DRIVE=Z:
#   ID_TRACKER_NETWORK_ROOT=\\FILE-SERVER\ID-TRACKER
#
# Leave ID_TRACKER_NETWORK_ROOT empty on machines where Z: is already mapped
# and accessible to the Apache service account.
ID_TRACKER_NETWORK_DRIVE=Z:
ID_TRACKER_NETWORK_ROOT=
